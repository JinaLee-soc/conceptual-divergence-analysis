# CDA environment configuration.
# Copy this file to `.env` and fill in the values. The `.env` file is
# git-ignored and must never be committed.

# Required for live CLI runs (`cda analyze`, `cda demo` without --mock-llm).
# Get a key at https://console.anthropic.com/.
# Not needed for --mock-llm mode, the test suite, or CI.
# GUI users can skip this entirely: the sidebar has a password field that
# keeps the key in session memory only (never on disk).
ANTHROPIC_API_KEY=

# Your email address, sent to the OpenAlex API as the "polite pool"
# identifier. Required by `cda diagnose` and `demo/build_toy_corpus.py`.
# See https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_MAILTO=

# Optional. A second model for the experimental multi-model verification
# hook (`cda verify`). Leave empty to disable. Example: claude-haiku-4-5-20251001
CDA_VERIFICATION_MODEL=
